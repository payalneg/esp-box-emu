menu "Esp-Box Configuration"

    choice ESP_BOX_BOARD
        prompt "Target board"
        default ESP_BOX_BOARD_ESPBOX

        config ESP_BOX_BOARD_ESPBOX
            bool "ESP32-S3-BOX / BOX-3"

        config ESP_BOX_BOARD_WAVESHARE_28
            bool "Waveshare ESP32-S3-Touch-LCD-2.8"
    endchoice

    config ESP_BOX_INTERRUPT_STACK_SIZE
        int "Interrupt stack size"
        default 4096
        help
            Size of the stack used for the interrupt handler. Used by the touch
            callback.
endmenu
